        :root {
            --bg: #f4f4f4;
            --card: #ffffff;
            --text: #333;
            --primary: #1a73e8;
        }

        [data-theme="dark"] {
            --bg: #1a1a1a;
            --card: #242424;
            --text: #e0e0e0;
            --primary: #4c8dff;
        }

        body {
