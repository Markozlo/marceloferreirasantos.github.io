            background: var(--bg);
            color: var(--text);
            display: flex;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: var(--card);
            height: 100vh;
            position: fixed;
            border-right: 1px solid #ccc;
            padding: 25px;
        }

            .sidebar h2 {
                margin-top: 0;
                color: var(--primary);
                font-size: 22px;
            }

            .sidebar a {
                display: block;
                padding: 12px 0;
                color: var(--text);
                text-decoration: none;
                font-weight: 600;
                font-size: 15px;
            }

                .sidebar a:hover {
                    color: var(--primary);
                }

        .profile-photo {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            display: block;
            margin: 20px auto;
            border: 4px solid var(--primary);
        }

        /* Conteúdo */
        .content {
            margin-left: 300px;
            padding: 35px;
            max-width: 900px;
        }

        h1 {
            color: var(--primary);
            margin-bottom: 5px;
        }

        .subtitle {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        h2 {
            color: var(--primary);
            border-left: 5px solid var(--primary);
            padding-left: 10px;
        }

        .card {
            background: var(--card);
            padding: 20px;
            margin: 20px 0;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.08);
        }

        ul {
            line-height: 1.7;
        }

        .download-btn {
