            padding: 12px 20px;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 15px;
            font-size: 15px;
        }

            .download-btn:hover {
                opacity: 0.8;
            }

        @media (max-width: 900px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
                border-bottom: 1px solid #ccc;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>

